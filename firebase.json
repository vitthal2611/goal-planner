{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.bat",
      "**/*.exe",
      "package.json",
      "package-lock.json",
      "vite.config.js",
      "firestore.rules"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/quick-track-demo.html"
      }
    ]
  }
}
